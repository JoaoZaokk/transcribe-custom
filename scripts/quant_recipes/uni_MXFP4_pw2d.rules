# Mixed-Precision Recipe: uni_MXFP4_pw2d (Smallest High-Accuracy Footprint, 326.6 MiB w/ PT+EN vocab surgery)
# Usage:
#   transcribe-quantize parakeet-ultra-pten-F16.gguf parakeet-ultra-pten-MXFP4-pw2d.gguf \
#     --quant F16 --squeeze-pw --rules scripts/quant_recipes/uni_MXFP4_pw2d.rules

role:pre_encode.conv=F16
